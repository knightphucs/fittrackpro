{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FitTrackProDb;Username=postgres;Password=YOUR_LOCAL_PASSWORD",
    "Redis": "localhost:6379",
    "Elasticsearch": "http://fittrackpro-elasticsearch:9200"
  },

  "Jwt": {
    "Secret": "",
    "Issuer": "FitTrackPro",
    "Audience": "FitTrackProUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "DefaultIndex": "foods_index"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },

  "EmailSettings": {
    "SmtpServer": "localhost",
    "Port": 587,
    "SenderName": "FitTrackPro Support",
    "SenderEmail": "phuchoang3103@gmail.com",
    "Username": "",
    "Password": ""
  },
  "AllowedHosts": "*",

  "FileStorage": {
    "Provider": "localhost",

    "LocalPath": "uploads",
    "BaseUrl": "http://localhost:5000/uploads",

    "Azure": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net",
      "ContainerName": "progress-photos"
    }
  },
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },

  "ImageCompression": {
    "MaxWidth": 1920,
    "Quality": 85,
    "ThumbnailWidth": 300
  },

  "Limits": {
    "MaxFileSizeInMB": 10,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "MaxFilesPerUpload": 10
  }
}
