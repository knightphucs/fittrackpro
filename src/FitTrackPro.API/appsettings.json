{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FitTrackProDb;Username=fittrack_user;Password=fittrack_password_123",
    "Redis": "fittrackpro-redis:6379",
    "Elasticsearch": "http://localhost:9200"
  },
  "Jwt": {
    "Secret": "81eef0fa651f44c659aa04ddf863bcc4",
    "Issuer": "FitTrackPro",
    "Audience": "FitTrackProUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "BaseUrl": "http://localhost:5000/uploads"
  },
  "Azure": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net",
    "ContainerName": "progress-photos"
  },

  "ImageCompression": {
    "MaxWidth": 1920,
    "Quality": 85,
    "ThumbnailWidth": 300
  },

  "Limits": {
    "MaxFileSizeInMB": 10,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "MaxFilesPerUpload": 10
  }
}
