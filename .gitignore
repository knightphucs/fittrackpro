## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
build/

# Logging
[Ll]og/
[Ll]ogs/
logs/
*.log

# MSTest / NUnit / Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage/
coverage-report/
coverage.json
coverage.cobertura.xml
*.coverage
*.coveragexml

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.db-shm
*.db-wal

# Docker
docker-compose.override.yml

# OS Generated
.DS_Store
Thumbs.db

# IDE / Editors
*.swp
*.swo
*~

# Backup files
*.bak
*.tmp

# Publish profiles & Packages
*.nupkg
*.snupkg
*.pubxml
*.PublishSettings

# Secrets / Configs
appsettings.Development.json
appsettings.Production.json

# Uploaded files
uploads/
!uploads/.gitkeep

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Postman
.postman/
postman/
postman_collection.json